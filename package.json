{
	"name": "soulframe",
	"version": "0.1.0-beta.0",
	"description": "Build AI personas that feel human, for any purpose and any messaging channel: character, daily agenda, mood, human-paced replies, memory and opt-in safeguards.",
	"keywords": [
		"ai",
		"persona",
		"chatbot",
		"character",
		"llm",
		"openai-compatible",
		"conversation",
		"memory",
		"sqlite",
		"scheduling",
		"safety",
		"typescript"
	],
	"author": "RubyDevil",
	"license": "MIT",
	"homepage": "https://github.com/RubyDevil/soulframe#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RubyDevil/soulframe.git"
	},
	"bugs": {
		"url": "https://github.com/RubyDevil/soulframe/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.13"
	},
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"type-check": "tsc --noEmit",
		"lint:pkg": "publint && attw --pack . --profile node16",
		"check": "npm run type-check && npm test && npm run build && npm run lint:pkg",
		"prepublishOnly": "npm run check"
	},
	"files": [
		"dist",
		"assets",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"yaml": "^2.6.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^22.20.5",
		"publint": "^0.3.25",
		"tsdown": "^0.23.7",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vitest": "^2.1.8"
	}
}
